# Copy this file to .env and fill in your values. NEVER commit .env to GitHub.

# Neon connection string (Neon dashboard -> Connect). Keep ?sslmode=require at the end.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Gemini API key from https://aistudio.google.com (free tier)
LLM_API_KEY=paste-your-gemini-key-here

# Models (change here if Google renames them or you hit free-tier limits)
LLM_MODEL=gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768

# Any long random string; protects POST /api/admin/ingest
ADMIN_TOKEN=change-this-to-a-long-random-string

# Optional
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# RATE_LIMIT_PER_10MIN=30
# EMBED_PROVIDER=hash      # offline fake embeddings (no API calls), for testing only
